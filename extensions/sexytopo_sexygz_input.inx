<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension>
  <name>SexyTopo Combined (Compressed) Input</name>
  <id>speleo.input.sexytopo.sexygz</id>
  <input>
    <extension>.sexy.json.gz</extension>
    <mimetype>application/x-sexytopo-sexygz</mimetype>
    <filetypename>SexyTopo Combined (*.sexy.json.gz)</filetypename>
  </input>
  <script>
    <command location="inx" interpreter="python">sexytopo2svg.py</command>
  </script>
</inkscape-extension>
