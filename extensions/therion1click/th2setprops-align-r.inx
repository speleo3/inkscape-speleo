<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension>
  <_name>6) align right</_name>
  <id>speleo.th2setprops-align-r</id>
  <param name="options" gui-hidden="true" type="string">-align r</param>
  <param name="merge" gui-hidden="true" type="bool">true</param>
  <effect needs-live-preview="false">
    <effects-menu>
      <submenu name="Therion 1Click" />
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">../th2setprops.py</command>
  </script>
</inkscape-extension>
